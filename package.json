{
  "name": "blaharbenyah-website",
  "version": "2.2.0",
  "private": true,
  "description": "Website for Blahar & Benyah Int'l Ltd — logistics, transportation and clearing services in Tema, Ghana. Static site built with Eleventy.",
  "scripts": {
    "build": "npm run clean && eleventy",
    "start": "eleventy --serve --port 8080",
    "clean": "rm -rf _site",
    "check": "node scripts/check-site.mjs && html-validate \"_site/**/*.html\"",
    "images": "python3 scripts/optimize-images.py",
    "preview": "node scripts/preview-server.mjs 8080"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "html-validate": "^11.16.2",
    "jsdom": "^26.1.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
