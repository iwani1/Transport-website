---
layout: layouts/base.njk
title: ""
description: "Blahar & Benyah Int'l Ltd — freight forwarding, transportation, customs clearing and warehousing in Tema, Ghana. Request a quote for safe, on-time cargo delivery."
bodyClass: home
priority: "1.0"
changefreq: weekly
---
        <!-- SLIDER START
        ============================================= -->
        <section id="slider" class="home-slider clearfix" aria-label="Introduction">
            <div class="slider-wrapper">
                <div class="flexslider clearfix">
                    <ul class="slides">
                        <li class="slide-item clearfix" style="background-image: url(/img/slider/slide-1.webp);">
                            <div class="flex-content">
                                <div class="container">
                                    <div class="row">
                                        <div class="caption-wrap">
                                            <div class="caption wow fadeInUp" data-wow-delay="0.5s">
                                                <h1>Reliable Transportation &amp; Logistics</h1>
                                            </div>
                                            <div class="caption wow fadeIn" data-wow-delay="1s">
                                                <p>We provide reliable transportation services designed to move your goods safely and on time. Our network and operational expertise enable efficient cargo movement across local and international routes, with a focus on cost control, transit time and cargo security.</p>
                                            </div>
                                            <div class="caption wow fadeInUp" data-wow-delay="1.5s">
                                                <a href="/contact.html#quote" class="button-normal">Request A Quote</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>

                        <li class="slide-item clearfix" style="background-image: url(/img/slider/slide-2.webp);">
                            <div class="flex-content">
                                <div class="container">
                                    <div class="row">
                                        <div class="caption-wrap">
                                            <div class="caption wow fadeInUp" data-wow-delay="0.5s">
                                                <h2>We Deliver Your Goods Fast</h2>
                                            </div>
                                            <div class="caption wow fadeIn" data-wow-delay="1s">
                                                <p>Our team manages every stage of the shipping process to reduce delays and keep your cargo moving on schedule. From collection to final delivery, we prioritize efficiency and clear communication so you stay informed and in control.</p>
                                            </div>
                                            <div class="caption wow fadeInUp" data-wow-delay="1.5s">
                                                <a href="/contact.html#quote" class="button-normal">Request A Quote</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </section>
        <!-- SLIDER END -->

        <!-- CONTENT START
        ============================================= -->
        <main id="content" class="clearfix">

            <!-- SERVICES START
            ============================================= -->
            <div class="services with-bg">
                <div class="container">
                    <div class="row">

                        <!-- Quick quote -->
                        <div class="email-quote clearfix">
                            <h4><label for="quick-email">Request A Quote</label></h4>
                            {% include "partials/form-quick-quote.njk" %}
                        </div>
                        <!-- Quick quote end -->
                    </div>
                </div>

                <div class="section-title text-center wow fadeIn">
                    <h2>Our Services</h2>
                </div>

                <div class="services-wrap-carousel">
                    {%- for s in services %}
                    <div class="item">
                        <div class="services-content">
                            <div class="services-image" style="background-image: url(/{{ s.image }});" role="img" aria-label="{{ s.imageAlt }}"></div>
                            <div class="services-text">
                                <h3 class="title">{{ s.title }}</h3>
                                <p>{{ s.card }}</p>
                                <a href="/services/{{ s.slug }}.html" class="button-normal with-icon">
                                    Read More<span class="visually-hidden"> about {{ s.title }}</span>
                                    <i class="icon icon-arrow-right" aria-hidden="true"></i>
                                </a>
                            </div>
                            <div class="overlay"></div>
                        </div>
                    </div>
                    {%- endfor %}
                </div>
            </div>
            <!-- SERVICES END -->

            <!-- FEATURES START
            ============================================= -->
            <div class="features wrapper">
                <div class="container">
                    <div class="row">
                        <div class="section-title text-center wow fadeIn">
                            <h2>Why Choose Us</h2>
                        </div>

                        <div class="features-wrap row">
                            {%- for f in features %}
                            <div class="col-md-4">
                                <div class="features-item wow fadeInUp" data-wow-delay="{{ (0.2 + loop.index0 * 0.2) | round(1) }}s">
                                    <div class="icon-wrap">
                                        <i class="{{ f.icon }}" aria-hidden="true"></i>
                                    </div>
                                    <div class="text">
                                        <h3 class="h4">{{ f.title }}</h3>
                                        <p>{{ f.text }}</p>
                                    </div>
                                </div>
                            </div>
                            {%- endfor %}
                        </div>
                    </div>
                </div>
            </div>
            <!-- FEATURES END -->

            <!-- HOW WE WORK + QUOTE FORM START (replaces the template's demo price calculator)
            ============================================= -->
            <div class="services-calculator bg-color" id="how-we-work">
                <div class="container">
                    <div class="row">
                        <div class="services-calculator-wrap row">
                            <div class="intro-section col-md-6">
                                <h2 class="title">How We Work</h2>
                                <p>Getting a shipment moving with {{ site.shortName }} is simple. Tell us what you need and we take care of the rest.</p>
                                <ol class="how-it-works">
                                    <li><strong>Tell us about your cargo</strong> What you are moving, where from, where to, and when it needs to arrive.</li>
                                    <li><strong>Receive a clear estimate</strong> We come back to you with a cost-effective, itemised quote and the best routing options.</li>
                                    <li><strong>We handle the rest</strong> Documentation, customs clearing, transport and delivery — with updates at every stage.</li>
                                </ol>
                                <div class="image">
                                    <img src="/img/content/forklift.webp" alt="Forklift carrying packaged goods" width="600" height="435" loading="lazy">
                                </div>
                            </div>

                            <div class="form-section col-md-6" id="quote">
                                {% include "partials/form-quote.njk" %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- HOW WE WORK + QUOTE FORM END -->

            <!-- TESTIMONIAL START
            ============================================= -->
            <div class="testimonial wrapper with-bg">
                <div class="container">
                    <div class="row">
                        <div class="section-title text-center wow fadeIn">
                            <h2>Testimonials</h2>
                        </div>

                        <div class="owl-carousel testimonial-carousel wow fadeIn" data-wow-delay="0.3s">
                            {%- for t in testimonials %}
                            <div class="testimonial-item">
                                <blockquote>
                                    <p>“{{ t.quote }}”</p>
                                </blockquote>
                                <div class="client-info">
                                    <div class="client-initials" aria-hidden="true">{{ t.name | initials }}</div>
                                    <div class="client-details">
                                        <h3>{{ t.name }}</h3>
                                        <p>{{ t.role }}</p>
                                    </div>
                                </div>
                            </div>
                            {%- endfor %}
                        </div>

                        {%- if site.partners and site.partners.length %}
                        <div class="our-partner">
                            {%- for p in site.partners %}
                            <div class="partner-logo col-md-15 wow fadeIn" data-wow-delay="{{ (loop.index * 0.3) | round(1) }}s">
                                <img src="{{ p.logo }}" alt="{{ p.name }}" loading="lazy">
                            </div>
                            {%- endfor %}
                        </div>
                        {%- endif %}
                    </div>
                </div>
            </div>
            <!-- TESTIMONIAL END -->

            {% include "partials/counters.njk" %}

        </main>
        <!-- CONTENT END -->
