---
layout: layouts/base.njk
title: "Contact"
description: "Contact Blahar & Benyah Int'l Ltd in Tema, Ghana — call (+233) 24 683 5764, email us, or send a message to request a logistics quote. Office beside GTP, Community 4, Valco Roundabout."
bodyClass: page-contact
priority: "0.9"
---
{%- set heroImage = 'img/slider/slide-1.webp' %}
{%- set heroShort = true %}
{%- set eyebrow = 'Contact' %}
{%- set heading = 'Let’s move<br><span class="outline">something.</span>' %}
{%- set lead = 'Call, WhatsApp or send the form — we reply during office hours, usually within the hour.' %}
{% include "partials/page-hero.njk" %}

        <section class="cpage" aria-label="Contact details and form">
            <div class="wrap cpage__grid">
                <div data-reveal>
                    <p class="eyebrow">Reach us</p>
                    <div class="c-list dark" style="margin-top:0">
                        {%- for ph in site.phones %}
                        <a href="tel:{{ ph.e164 }}"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg></span><span><small>{% if loop.first %}Call{% else %}Line&nbsp;{{ loop.index }}{% endif %}</small><b>{{ ph.display | nbsp }}</b></span></a>
                        {%- endfor %}
                        {%- if site.whatsapp and site.whatsapp.number %}
                        <a href="https://wa.me/{{ site.whatsapp.number }}?text={{ site.whatsapp.message | urlencode }}" rel="noopener" target="_blank"><span class="ic"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 3.9A11 11 0 0 0 2.6 17.1L1 23l6-1.6A11 11 0 0 0 20 3.9zM12 20.9a9 9 0 0 1-4.6-1.3l-.3-.2-3.6 1 1-3.5-.2-.3A9 9 0 1 1 12 20.9zm5-6.7c-.3-.1-1.6-.8-1.9-.9s-.4-.1-.6.1-.7.9-.9 1.1-.3.2-.6.1a7.4 7.4 0 0 1-3.7-3.2c-.3-.5.3-.4.8-1.5.1-.2 0-.3 0-.5l-.9-2c-.2-.5-.4-.5-.6-.5h-.5a1 1 0 0 0-.8.4 3.2 3.2 0 0 0-1 2.3 5.6 5.6 0 0 0 1.2 3 12.8 12.8 0 0 0 4.9 4.3c1.8.8 2.5.9 3.4.7a3 3 0 0 0 1.9-1.3 2.4 2.4 0 0 0 .2-1.4c-.1-.1-.3-.2-.6-.3z"/></svg></span><span><small>WhatsApp</small><b>Chat with us</b></span></a>
                        {%- endif %}
                        <a href="mailto:{{ site.email }}"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span><span><small>E-mail</small><b>{{ site.email }}</b></span></a>
                        <a href="{{ site.mapLink }}" rel="noopener" target="_blank"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s7-7.1 7-12a7 7 0 1 0-14 0c0 4.9 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg></span><span><small>Office — get directions</small><b>{{ site.address.line1 }}, {{ site.address.line2 }}, {{ site.address.city }}, {{ site.address.country }}</b></span></a>
                    </div>

                    <div class="hours">
                        <h3>Office hours</h3>
                        {%- for d in site.hours.days %}
                        <div><span>{{ d }}</span><b>{{ site.hours.opens }} – {{ site.hours.closes }}</b></div>
                        {%- endfor %}
                        {%- for d in site.hours.closed %}
                        <div class="closed"><span>{{ d }}</span><b>Closed</b></div>
                        {%- endfor %}
                    </div>
                </div>

                <div>
                    {%- set formClass = 'form--dark' %}
                    {% include "partials/form-contact.njk" %}
                </div>
            </div>

            <div class="wrap">
                <div class="map-embed dark" data-reveal>
                    <iframe title="Map showing the location of {{ site.name }} in {{ site.address.city }}" src="{{ site.mapEmbedUrl }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
                </div>
            </div>
        </section>
