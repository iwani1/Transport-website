---
layout: layouts/base.njk
title: "About Us"
description: "Learn about Blahar & Benyah Int'l Ltd — a Tema-based logistics company offering freight forwarding, transportation, clearing and warehousing, built on reliability and clear communication."
bodyClass: page-about
priority: "0.8"
---
{%- set heroImage = 'img/slider/slide-2.webp' %}
{%- set eyebrow = 'About us' %}
{%- set heading = 'Built in Tema.<br><span class="outline">Driven by delivery.</span>' %}
{%- set lead = 'A forward-driven logistics and business support company — small enough to know every job by name, organised enough to deliver it on time.' %}
{% include "partials/page-hero.njk" %}

        <!-- COMPANY PROFILE -->
        <section class="sec" aria-labelledby="profile-title">
            <div class="wrap profile">
                <div class="prose" data-reveal>
                    <p class="eyebrow">Company profile</p>
                    <h2 class="visually-hidden" id="profile-title">Company profile</h2>
                    <p class="intro">Blahar &amp; Benyah Int’l Ltd is a forward-driven company delivering integrated logistics and business support services. We specialize in freight forwarding, transportation, clearing, and supply chain coordination.</p>
                    <p>Our operations are structured to support smooth cargo movement across local and international routes. We focus on efficiency, cost control, and timely execution in every project we handle. Our team combines industry knowledge with practical problem-solving to deliver dependable results — managing documentation, compliance, and coordination with precision and accountability.</p>
                    <p>We maintain clear communication to keep clients informed at every stage. Our systems are designed to reduce delays and improve operational flow. At Blahar &amp; Benyah Int’l Ltd, we build long-term partnerships through reliability, professionalism, and consistent performance.</p>
                    <div class="actions">
                        <a class="btn btn--orange magnetic" href="/services.html">Our services</a>
                        <a class="btn btn--ghost magnetic" href="/contact.html">Get in touch</a>
                    </div>
                </div>
                <div class="collage" data-reveal style="--delay:.15s">
                    <img src="/img/slider/company-slide-1.webp" alt="Container ship being loaded by gantry cranes at a port" width="790" height="526" loading="lazy">
                    <img src="/img/content/company-thumb-1.webp" alt="Stacked shipping containers" width="370" height="280" loading="lazy">
                    <img src="/img/content/company-thumb-3.webp" alt="Port worker in protective clothing overseeing container handling" width="370" height="280" loading="lazy">
                </div>
            </div>
        </section>

        <!-- MISSION / VISION / GOAL -->
        <section class="sec sec--light" aria-labelledby="values-title">
            <div class="wrap">
                <div class="sec__head">
                    <div data-reveal>
                        <p class="eyebrow">What drives us</p>
                        <h2 class="title dark" id="values-title">Mission, vision<br><span class="outline">and where next.</span></h2>
                    </div>
                </div>
                <div class="values">
                    <article class="value" data-reveal>
                        <img src="/img/content/company-thumb-1.webp" alt="" width="370" height="280" loading="lazy">
                        <div><b>01</b><h3>Our mission</h3><p>To provide practical, efficient, and dependable solutions that support business growth and trade operations while maintaining the highest professional standards.</p></div>
                    </article>
                    <article class="value" data-reveal style="--delay:.1s">
                        <img src="/img/content/company-thumb-2.webp" alt="" width="370" height="280" loading="lazy">
                        <div><b>02</b><h3>Our vision</h3><p>To become a trusted regional leader in logistics and integrated service delivery, recognized for reliability, integrity, and operational excellence.</p></div>
                    </article>
                    <article class="value" data-reveal style="--delay:.2s">
                        <img src="/img/content/company-thumb-3.webp" alt="" width="370" height="280" loading="lazy">
                        <div><b>03</b><h3>Expanding goal</h3><p>Blahar &amp; Benyah Int’l Ltd aims to expand its operations across key regional and international trade routes. We plan to strengthen our logistics network to support growing client demand.</p></div>
                    </article>
                </div>
            </div>
        </section>

        <!-- LEADERSHIP -->
        <section class="sec" aria-labelledby="team-title">
            <div class="wrap team">
                {%- for m in team %}
                <figure class="team__photo" data-reveal>
                    <img src="/{{ m.photo }}" alt="{{ m.alt }}" width="600" height="900" loading="lazy">
                    <figcaption><b>{{ m.name }}</b><span>{{ m.role }}</span></figcaption>
                </figure>
                {%- endfor %}
                <div data-reveal style="--delay:.15s">
                    <p class="eyebrow">Leadership</p>
                    <h2 class="title" id="team-title" style="font-size:clamp(44px,6vw,88px)">Our <span class="outline">leaders.</span></h2>
                    <blockquote class="pull" style="margin-top:28px">Client satisfaction guides our service approach and operational standards — every shipment gets the same attention, whether it is one pallet or forty containers.</blockquote>
                    <p class="lead" style="margin-top:26px">Our team combines industry knowledge with practical problem-solving to deliver dependable results, managing documentation, compliance and coordination with precision and accountability.</p>
                </div>
            </div>
        </section>

        <!-- NUMBERS -->
        <section class="sec sec--light sec--tight" aria-labelledby="numbers-title">
            <div class="wrap">
                <p class="eyebrow" id="numbers-title">In numbers</p>
                <div class="hero__stats hero__stats--5 stats--light" style="margin-top:0;animation:none;opacity:1">
                    {%- for st in stats %}
                    <div class="stat"><b><span data-count="{{ ((st.value / 1000) | round) if st.value >= 100000 else st.value }}">0</span>{% if st.value >= 100000 %}<em>k</em>{% elif st.suffix %}<em>{{ st.suffix }}</em>{% endif %}</b><span>{{ st.label }}</span></div>
                    {%- endfor %}
                </div>
            </div>
        </section>

{%- set ctaTitle = 'Let’s work<br>together.' %}
{%- set ctaLead = 'Tell us what you move and how often — we will come back with a plan and a price the same day.' %}
{% include "partials/cta-band.njk" %}
