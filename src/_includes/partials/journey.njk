{#- "The journey": a ~4-screen-tall section with a sticky stage. site.js maps scroll progress onto the
    layers (port leaves, city arrives, road and palms scroll, dusk turns to night, wheels turn, km counter).
    With prefers-reduced-motion the scene is static and all four milestones are listed. -#}
        <section class="journey" id="journey" aria-labelledby="journey-title">
            <div class="journey__stage">
                <div class="jl jl-sky" aria-hidden="true"></div>
                <div class="jl jl-sun" aria-hidden="true"></div>
                <div class="jl jl-night" aria-hidden="true"></div>
                <div class="jl jl-stars" aria-hidden="true"></div>
                <div class="jl jl-hills" aria-hidden="true"></div>
                <div class="jl jl-palms" aria-hidden="true"></div>
                <div class="jl jl-port" aria-hidden="true"></div>
                <div class="jl jl-city" aria-hidden="true"></div>
                <div class="jl jl-posts" aria-hidden="true"></div>
                <div class="jl jl-fog" aria-hidden="true"></div>
                <div class="jl jl-road" aria-hidden="true"></div>
                <div class="jl jl-lines" aria-hidden="true"></div>
                <div class="jl jl-glow" aria-hidden="true"></div>

                <div class="truck" aria-hidden="true">
                    <svg viewBox="0 0 760 230" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="beamGrad" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ffd27a" stop-opacity=".55"/><stop offset="1" stop-color="#ffd27a" stop-opacity="0"/></linearGradient>
                            <linearGradient id="boxGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff8a3d"/><stop offset="1" stop-color="#e0591a"/></linearGradient>
                            <linearGradient id="cabGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2fb3a6"/><stop offset="1" stop-color="#1f6f6f"/></linearGradient>
                            <linearGradient id="glassGrad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e9f6f7" stop-opacity=".9"/><stop offset="1" stop-color="#9fd8d6" stop-opacity=".5"/></linearGradient>
                            <pattern id="corrugate" width="14" height="10" patternUnits="userSpaceOnUse"><rect width="14" height="10" fill="transparent"/><rect x="0" width="2" height="10" fill="rgba(0,0,0,.14)"/><rect x="7" width="2" height="10" fill="rgba(255,255,255,.08)"/></pattern>
                        </defs>
                        <!-- headlight beam -->
                        <polygon class="beam" points="548,146 760,70 760,230 548,172" fill="url(#beamGrad)"/>
                        <!-- ground shadow -->
                        <ellipse cx="290" cy="212" rx="285" ry="7" fill="rgba(0,0,0,.45)"/>
                        <!-- trailer chassis -->
                        <rect x="20" y="150" width="385" height="16" rx="3" fill="#0c1f27"/>
                        <rect x="30" y="166" width="140" height="8" fill="#0a1a20"/>
                        <rect x="300" y="166" width="60" height="22" fill="#0a1a20"/>
                        <!-- container -->
                        <rect x="12" y="36" width="388" height="116" rx="4" fill="url(#boxGrad)"/>
                        <rect x="12" y="36" width="388" height="116" rx="4" fill="url(#corrugate)"/>
                        <rect x="12" y="36" width="388" height="6" fill="rgba(255,255,255,.18)"/>
                        <rect x="12" y="146" width="388" height="6" fill="rgba(0,0,0,.25)"/>
                        <rect x="12" y="36" width="10" height="116" fill="rgba(0,0,0,.22)"/>
                        <rect x="390" y="36" width="10" height="116" fill="rgba(0,0,0,.22)"/>
                        <rect x="36" y="60" width="300" height="60" fill="#0c1f27" opacity=".92" rx="2"/>
                        <text x="186" y="104" text-anchor="middle" font-family="'Bebas Neue', Impact, sans-serif" font-size="44" letter-spacing="2" fill="#f4f1ea">BLAHAR &amp; BENYAH</text>
                        <text x="186" y="134" text-anchor="middle" font-family="Inter, Arial, sans-serif" font-weight="600" font-size="11" letter-spacing="3" fill="#07141a">LOGISTICS · TEMA · GHANA</text>
                        <!-- rear lights + mudguard -->
                        <rect x="12" y="156" width="8" height="10" fill="#ff3b30"/>
                        <path d="M60 178 a32 32 0 0 1 64 0z" fill="#0a1a20"/><path d="M120 178 a32 32 0 0 1 64 0z" fill="#0a1a20"/>
                        <!-- cab -->
                        <path d="M408 70 h98 a12 12 0 0 1 10 5 l26 44 a14 14 0 0 1 2 8 v44 a8 8 0 0 1 -8 8 h-128 z" fill="url(#cabGrad)"/>
                        <path d="M408 70 h98 a12 12 0 0 1 10 5 l26 44 h-134z" fill="rgba(255,255,255,.08)"/>
                        <rect x="408" y="52" width="84" height="20" rx="6" fill="#1a5f61"/>
                        <rect x="414" y="56" width="72" height="8" rx="3" fill="#0c1f27"/>
                        <!-- windshield + side window -->
                        <path d="M470 80 h40 a6 6 0 0 1 5 3 l22 36 h-67 z" fill="url(#glassGrad)"/>
                        <rect x="420" y="80" width="42" height="40" rx="4" fill="url(#glassGrad)"/>
                        <!-- door line + handle + mirror -->
                        <path d="M466 80 v92" stroke="rgba(0,0,0,.25)" stroke-width="2"/>
                        <rect x="430" y="132" width="20" height="4" rx="2" fill="#0c1f27"/>
                        <rect x="538" y="86" width="8" height="26" rx="2" fill="#0c1f27"/>
                        <!-- grille, bumper, headlight -->
                        <rect x="526" y="124" width="18" height="30" rx="3" fill="#0c1f27"/>
                        <rect x="529" y="128" width="12" height="3" fill="#2fb3a6"/><rect x="529" y="136" width="12" height="3" fill="#2fb3a6"/><rect x="529" y="144" width="12" height="3" fill="#2fb3a6"/>
                        <rect x="400" y="172" width="148" height="12" rx="3" fill="#0c1f27"/>
                        <rect x="536" y="156" width="12" height="12" rx="2" fill="#ffd27a"/>
                        <circle cx="548" cy="162" r="4" fill="#fff8e0"/>
                        <!-- fuel tank, steps -->
                        <rect x="412" y="156" width="44" height="18" rx="6" fill="#163d44"/>
                        <rect x="462" y="160" width="24" height="4" fill="#0c1f27"/><rect x="462" y="168" width="24" height="4" fill="#0c1f27"/>
                        <!-- cab wheel arch -->
                        <path d="M476 180 a34 34 0 0 1 68 0z" fill="#0c1f27"/>
                        <!-- wheels (rotated by JS) -->
                        <g class="wheel" transform="translate(92 180)"><circle r="28" fill="#111"/><circle r="17" fill="#cfd6d8"/><circle r="17" fill="none" stroke="#8a969a" stroke-width="2"/><path d="M0-14V14M-14 0H14M-10-10L10 10M-10 10L10-10" stroke="#5b686c" stroke-width="3"/><circle r="4" fill="#5b686c"/></g>
                        <g class="wheel" transform="translate(152 180)"><circle r="28" fill="#111"/><circle r="17" fill="#cfd6d8"/><circle r="17" fill="none" stroke="#8a969a" stroke-width="2"/><path d="M0-14V14M-14 0H14M-10-10L10 10M-10 10L10-10" stroke="#5b686c" stroke-width="3"/><circle r="4" fill="#5b686c"/></g>
                        <g class="wheel" transform="translate(396 180)"><circle r="28" fill="#111"/><circle r="17" fill="#cfd6d8"/><circle r="17" fill="none" stroke="#8a969a" stroke-width="2"/><path d="M0-14V14M-14 0H14M-10-10L10 10M-10 10L10-10" stroke="#5b686c" stroke-width="3"/><circle r="4" fill="#5b686c"/></g>
                        <g class="wheel" transform="translate(510 180)"><circle r="28" fill="#111"/><circle r="17" fill="#cfd6d8"/><circle r="17" fill="none" stroke="#8a969a" stroke-width="2"/><path d="M0-14V14M-14 0H14M-10-10L10 10M-10 10L10-10" stroke="#5b686c" stroke-width="3"/><circle r="4" fill="#5b686c"/></g>
                    </svg>
                </div>

                <div class="hud">
                    <div class="hud__top">
                        <h2 class="hud__title" id="journey-title">The journey of your cargo · Tema → Kumasi</h2>
                        <div class="hud__km"><span data-km="250">0</span><em>km</em></div>
                    </div>
                    <div class="hud__track" aria-hidden="true"><i></i><b></b><b></b><b></b><b></b></div>
                    <div class="caps">
                        <div class="cap"><small>Km 0 · Tema Port</small><h3>Cleared.</h3><p>Declaration lodged, duties explained and paid, container released from the terminal — our office is minutes from the gate.</p></div>
                        <div class="cap"><small>Km 12 · Community 4</small><h3>Loaded.</h3><p>Checked into our warehouse if you need it, stock recorded, truck and driver booked for first light.</p></div>
                        <div class="cap"><small>Km 140 · N6 highway</small><h3>On the road.</h3><p>Our own truck, our own driver — and their number in your WhatsApp. Status updates at every stop.</p></div>
                        <div class="cap"><small>Km 250 · Kumasi</small><h3>Delivered.</h3><p>Signed for, photographed on request, one itemised invoice. Same team, start to finish.</p></div>
                    </div>
                </div>
                <span class="journey__cue" aria-hidden="true">Scroll to drive</span>
            </div>
        </section>
