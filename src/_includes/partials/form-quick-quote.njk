{%- set formType = 'quick-quote' %}
                            <form method="post" action="{% include 'partials/form-action.njk' %}" data-ajax-form>
                                {%- include "partials/form-hidden.njk" %}
                                <input class="col-md-6" type="email" id="quick-email" placeholder="Your Email" name="email" required autocomplete="email" inputmode="email">
                                <div class="category_filter col-md-6">
                                    <label for="quick-service" class="visually-hidden">Service</label>
                                    <select name="service" id="quick-service">
                                        <option value="">Services</option>
                                        {%- for s in services %}
                                        <option>{{ s.title }}</option>
                                        {%- endfor %}
                                    </select>
                                    <button type="submit" class="button-normal"><span>send now</span></button>
                                </div>
                                <p class="form-status" aria-live="polite"></p>
                            </form>
