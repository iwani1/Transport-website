{#- Fixed header + full-screen menu. The header turns solid after scrolling and hides on scroll-down (site.js). -#}
{%- set isHome = page.url == '/index.html' or page.url == '/' %}
{%- set onServices = page.url == '/services.html' or ('/services/' in page.url) %}
{%- set onAbout = page.url == '/about-us.html' %}
{%- set onContact = page.url == '/contact.html' %}
{%- set quoteHref = '/#contact' if isHome else '/contact.html#quote' %}
    <header class="hdr" id="hdr">
        <div class="wrap hdr__in">
            <a class="brand" href="/" aria-label="{{ site.name }} — home">
                <img class="brand__logo" src="/img/logo.png" alt="" width="720" height="188">
            </a>
            <nav class="nav" aria-label="Main">
                <a href="/services.html"{% if onServices %} class="is-active" aria-current="{{ 'page' if page.url == '/services.html' else 'true' }}"{% endif %}>Services</a>
                <a href="/#process">How it works</a>
                <a href="/about-us.html"{% if onAbout %} class="is-active" aria-current="page"{% endif %}>About us</a>
                <a href="/contact.html"{% if onContact %} class="is-active" aria-current="page"{% endif %}>Contact</a>
            </nav>
            <a class="hdr__phone" href="tel:{{ site.phones[0].e164 }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
                {{ site.phones[0].display | nbsp }}
            </a>
            <a class="btn btn--orange btn--sm magnetic" href="{{ quoteHref }}">Get a quote</a>
            <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu"><span></span></button>
        </div>
    </header>

    <div class="menu" id="menu" inert>
        <a class="big" href="/" style="transition-delay:.1s"><span>01</span>Home</a>
        <a class="big" href="/services.html" style="transition-delay:.17s"><span>02</span>Services</a>
        <a class="big" href="/about-us.html" style="transition-delay:.24s"><span>03</span>About us</a>
        <a class="big" href="/contact.html" style="transition-delay:.31s"><span>04</span>Contact</a>
        <ul class="menu__sub" aria-label="Services">
            {%- for s in services %}
            <li><a href="/services/{{ s.slug }}.html">{{ s.title }}</a></li>
            {%- endfor %}
        </ul>
        <div class="menu__foot">
            <a class="btn btn--orange btn--sm" href="tel:{{ site.phones[0].e164 }}">Call&nbsp;{{ site.phones[0].display | nbsp }}</a>
            {%- if site.whatsapp and site.whatsapp.number %}
            <a class="btn btn--wa btn--sm" href="https://wa.me/{{ site.whatsapp.number }}?text={{ site.whatsapp.message | urlencode }}" rel="noopener" target="_blank">WhatsApp</a>
            {%- endif %}
        </div>
    </div>
