{#- Orange diagonal call-to-action band. Set `ctaTitle` / `ctaLead` before including to override the copy. -#}
{%- set isHome = page.url == '/index.html' or page.url == '/' %}
    <section class="cta" aria-labelledby="cta-title">
        <div class="wrap cta__grid">
            <div data-reveal>
                <h2 class="title" id="cta-title">{{ ctaTitle | default('Have cargo<br>arriving in Tema?') | safe }}</h2>
                <p class="lead">{{ ctaLead | default('Send us the bill of lading and we will tell you the clearing cost and the delivery date — today.') }}</p>
            </div>
            <div class="cta__actions" data-reveal style="--delay:.15s">
                <a class="btn btn--dark magnetic" href="{{ '/#contact' if isHome else '/contact.html#quote' }}">Request a quote</a>
                {%- if site.whatsapp and site.whatsapp.number %}
                <a class="btn btn--wa magnetic" href="https://wa.me/{{ site.whatsapp.number }}?text={{ (waMessage or site.whatsapp.message) | urlencode }}" rel="noopener" target="_blank">WhatsApp us now</a>
                {%- else %}
                <a class="btn btn--wa magnetic" href="tel:{{ site.phones[0].e164 }}">Call&nbsp;{{ site.phones[0].display | nbsp }}</a>
                {%- endif %}
            </div>
        </div>
    </section>
