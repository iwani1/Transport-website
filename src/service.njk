---
layout: layouts/base.njk
pagination:
  data: services
  size: 1
  alias: service
  addAllPagesToCollections: true
permalink: "services/{{ service.slug }}.html"
eleventyComputed:
  title: "{{ service.title | safe }}"
  description: "{{ service.metaDescription | safe }}"
  ogImage: "/{{ service.image }}"
  waMessage: "{{ service.whatsapp | safe }}"
  crumbs:
    - label: "Services"
      url: "/services.html"
bodyClass: page-service
priority: "0.8"
---
{%- set heroImage = service.hero %}
{%- set heroImageMobile = service.heroMobile %}
{%- set eyebrow = service.title %}
{%- set heading = service.displayTitle %}
{%- set lead = service.blurb %}
{%- set heroActions %}<a class="btn btn--orange magnetic" href="#quote">{{ service.ctaLabel }}</a><a class="btn btn--ghost magnetic" href="tel:{{ site.phones[0].e164 }}">Call&nbsp;{{ site.phones[0].display | nbsp }}</a>{% endset %}
{% include "partials/page-hero.njk" %}

        <section class="svc" aria-label="{{ service.title }} details">
            <div class="wrap svc__grid">
                <article class="prose" data-reveal>
                    {%- for para in service.paragraphs %}
                    <p{% if loop.first %} class="intro"{% endif %}>{{ para }}</p>
                    {%- endfor %}

                    <h2>What we handle</h2>
                    <ul class="checks">
                        {%- for b in service.bullets %}
                        <li>{{ b }}</li>
                        {%- endfor %}
                    </ul>

                    <h2>How it works</h2>
                    <p>Send us the details by WhatsApp, e-mail or the form on this page. You get an itemised quote the same day; once you confirm, the same team handles the job from start to finish and keeps you updated at every step.</p>
                    <div class="actions">
                        <a class="btn btn--orange magnetic" href="#quote">{{ service.ctaLabel }}</a>
                        <a class="btn btn--ghost magnetic" href="/services.html">All services</a>
                    </div>

                    {%- if service.faqs and service.faqs.length %}
                    <section class="faq" aria-labelledby="faq-title">
                        <h2 id="faq-title">Questions we get asked</h2>
                        {%- for f in service.faqs %}
                        <details class="faq__item"{% if loop.first %} open{% endif %}>
                            <summary><span>{{ f.q }}</span><i aria-hidden="true"></i></summary>
                            <div class="faq__a"><p>{{ f.a }}</p></div>
                        </details>
                        {%- endfor %}
                        <p class="faq__more">Something else? <a href="https://wa.me/{{ site.whatsapp.number }}?text={{ (waMessage or site.whatsapp.message) | urlencode }}" rel="noopener" target="_blank">Ask on WhatsApp</a> or <a href="#quote">use the form</a>.</p>
                    </section>
                    {%- endif %}
                </article>

                <aside class="aside">
                    {%- set formClass = 'form--dark' %}
                    {%- set formTitle = service.ctaLabel %}
                    {%- set formCompact = true %}
                    {%- set formService = service.title %}
                    {% include "partials/form-quote.njk" %}

                    <div class="panel" data-reveal>
                        <h3>Other services</h3>
                        <ul>
                            {%- for s in services %}
                            <li{% if s.slug == service.slug %} class="is-active"{% endif %}><a href="/services/{{ s.slug }}.html"{% if s.slug == service.slug %} aria-current="page"{% endif %}>{{ s.title }}</a></li>
                            {%- endfor %}
                        </ul>
                    </div>

                    <div class="panel" data-reveal>
                        <h3>Talk to us</h3>
                        <div class="contact-lines">
                            <small>Call</small>
                            {%- for ph in site.phones %}
                            <a href="tel:{{ ph.e164 }}">{{ ph.display | nbsp }}</a>
                            {%- endfor %}
                            <small>E-mail</small>
                            <a href="mailto:{{ site.email }}">{{ site.email }}</a>
                            {%- if site.whatsapp and site.whatsapp.number %}
                            <small>WhatsApp</small>
                            <a href="https://wa.me/{{ site.whatsapp.number }}?text={{ (waMessage or site.whatsapp.message) | urlencode }}" rel="noopener" target="_blank">Chat on WhatsApp</a>
                            {%- endif %}
                            <small>Hours</small>
                            <span>{{ site.hours.summary }}</span>
                        </div>
                    </div>
                </aside>
            </div>
        </section>

{%- set ctaTitle = 'Need ' ~ (service.title | lower | replace('&', '&amp;')) ~ '<br>sorted this week?' %}
{%- set ctaLead = 'Tell us what you have and where it needs to go — we come back with a clear, itemised quote the same day.' %}
{% include "partials/cta-band.njk" %}
